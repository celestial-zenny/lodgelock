# Copy to .env.local and fill in. NEVER commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — use only in route handlers / server actions after your own authz checks.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interswitch (SANDBOX ONLY)
INTERSWITCH_BASE_URL=https://qa.interswitchng.com
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_WEBHOOK_SECRET=

# Fallback: Paystack TEST mode only (sk_test_...)
PAYSTACK_SECRET_KEY=

# Cron endpoint auth (auto-confirm after 72h)
CRON_SECRET=
