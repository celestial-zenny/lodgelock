# Copy to .env.local and fill in. NEVER commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — use only in route handlers / server actions after your own authz checks.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interswitch Web Checkout (SANDBOX ONLY — the app refuses any mode other than TEST)
INTERSWITCH_MODE=TEST
# Public test merchant from Interswitch's QuickStart; replace with your sandbox merchant if you have one
INTERSWITCH_MERCHANT_CODE=MX6072
INTERSWITCH_PAY_ITEM_ID=9405967
# Sandbox hosts differ between Interswitch doc versions; override if checkout/requery 404s
INTERSWITCH_CHECKOUT_SCRIPT_URL=https://newwebpay-sandbox.interswitchng.com/inline-checkout.js
INTERSWITCH_REQUERY_URL=https://sandbox.interswitchng.com/collections/api/v1/gettransaction.json
# Secret key from the Interswitch dashboard webhook settings (HMAC-SHA512 signing key)
INTERSWITCH_WEBHOOK_SECRET=

# Fallback: Paystack TEST mode only (sk_test_...)
PAYSTACK_SECRET_KEY=

# Cron endpoint auth (auto-confirm after 72h)
CRON_SECRET=
